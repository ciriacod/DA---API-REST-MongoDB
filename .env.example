# Puerto del servidor HTTP
PORT=3000
# Cadena de conexión a MongoDB (debe ser un replica set para usar transacciones; MongoDB Atlas ya lo es)
MONGODB_URI=mongodb://127.0.0.1:27017/tienda?replicaSet=rs0
# Secreto para firmar los JWT (usar una cadena larga y aleatoria)
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio
# Tiempo de vida del token
JWT_EXPIRES_IN=2h
# Costo (rondas de sal) de bcrypt
BCRYPT_SALT_ROUNDS=10
